{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["nitrosubject"],
  "ios": {
    "iosModuleName": "NitroSubject"
  },
  "android": {
    "androidNamespace": ["nitrosubject"],
    "androidCxxLibName": "NitroSubject"
  },
  "autolinking": {
    "SubjectDetector": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridSubjectDetector"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridSubjectDetector"
      }
    }
  },
  "ignorePaths": ["**/node_modules"]
}
