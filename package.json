{
  "name": "@salve-software/react-native-nitro-subject",
  "version": "0.0.0",
  "description": "Find the main subject of a photo and get its bounding box. Apple Vision on iOS, ML Kit Subject Segmentation via Google Play services on Android.",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "scripts": {
    "test": "jest",
    "test:native:ios": "swift test --package-path ios/tests/SubjectDetectorTests",
    "test:native:android": "cd example/android && ./gradlew :salve-software_react-native-nitro-subject:testDebugUnitTest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"example/App.tsx\" \"example/src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"example/App.tsx\" \"example/src/**/*.{ts,tsx}\"",
    "clean": "git clean -dfX",
    "release": "semantic-release",
    "build": "rm -rf lib && yarn typecheck && bob build",
    "codegen": "nitrogen --logLevel=\"debug\" && node post-script.js && yarn build",
    "example": "yarn workspace react-native-nitro-subject-example"
  },
  "keywords": [
    "react-native",
    "nitro-modules",
    "subject-detection",
    "foreground",
    "segmentation",
    "saliency",
    "auto-crop",
    "vision",
    "mlkit"
  ],
  "files": [
    "src",
    "!src/**/__tests__",
    "lib",
    "nitrogen",
    "nitro.json",
    "post-script.js",
    "android/build.gradle",
    "android/fix-prefab.gradle",
    "android/gradle.properties",
    "android/CMakeLists.txt",
    "android/src/main",
    "ios/**/*.h",
    "ios/**/*.m",
    "ios/**/*.mm",
    "ios/**/*.swift",
    "!ios/tests",
    "*.podspec",
    "README.md"
  ],
  "workspaces": [
    "example"
  ],
  "repository": "https://github.com/Salve-Software/react-native-nitro-subject.git",
  "author": "Salve-Software",
  "license": "MIT",
  "bugs": "https://github.com/Salve-Software/react-native-nitro-subject/issues",
  "homepage": "https://github.com/Salve-Software/react-native-nitro-subject#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "devDependencies": {
    "@babel/preset-env": "^7.25.3",
    "@babel/preset-typescript": "^7.27.1",
    "@jamesacarr/eslint-formatter-github-actions": "^0.2.0",
    "@react-native/babel-preset": "0.86.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/jest": "^29.5.12",
    "@types/react": "19.2.0",
    "babel-jest": "^29.7.0",
    "conventional-changelog-conventionalcommits": "^10.2.1",
    "jest": "^29.7.0",
    "nitrogen": "0.37.2",
    "prettier": "^3.6.2",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-builder-bob": "^0.40.18",
    "react-native-nitro-modules": "0.37.2",
    "semantic-release": "^25.0.7",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": "*"
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@react-native",
      "prettier"
    ],
    "plugins": [
      "prettier"
    ],
    "rules": {
      "prettier/prettier": [
        "warn",
        {
          "quoteProps": "consistent",
          "singleQuote": true,
          "tabWidth": 2,
          "trailingComma": "es5",
          "useTabs": false,
          "printWidth": 100
        }
      ]
    }
  },
  "eslintIgnore": [
    "node_modules/",
    "lib/",
    "nitrogen/"
  ],
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false,
    "printWidth": 100
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ],
    "exclude": "**/__tests__/**"
  },
  "packageManager": "yarn@4.9.1"
}
